{
  "rules": {
    "pokeswipe_radar": {
      ".read": false,
      ".write": false,
      "stats": {
        ".read": true,
        ".write": false,
        "totalVisits": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
        },
        "$other": {
          ".write": false,
          ".validate": false
        }
      },
      "presence": {
        ".read": true,
        ".indexOn": [
          "ts"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['online', 'ts']) && newData.child('ts').val() <= now + 60000 && newData.child('ts').val() >= now - 60000)",
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "g": {
            ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 9999"
          },
          "a": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rate": {
        ".read": false,
        ".write": false
      },
      "chat": {
        ".read": false,
        ".write": false
      },
      "pullwall": {
        ".read": false,
        ".write": false
      },
      "radar_users": {
        ".read": false,
        ".write": false
      },
      "market": {
        ".read": false,
        ".write": false
      },
      "deals": {
        ".read": false,
        ".write": false
      },
      "$other": {
        ".read": false,
        ".write": false
      }
    }
  }
}
