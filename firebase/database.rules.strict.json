{
  "rules": {
    "pokeswipe_radar": {
      "stats": {
        ".read": true,
        ".write": false,
        "totalVisits": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
        },
        "$other": {
          ".validate": false
        }
      },
      "presence": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['online', 'ts']) && newData.child('online').isBoolean() && newData.child('ts').isNumber() && newData.child('ts').val() <= now + 60000)",
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rate": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$kind": {
            ".validate": "$kind.matches(/^(radar)$/) && newData.isNumber() && newData.val() === now && (!data.exists() || now - data.val() >= 3000)"
          }
        }
      },
      "chat": {
        ".read": false,
        ".write": false
      },
      "pullwall": {
        ".read": false,
        ".write": false
      },
      "radar_users": {
        ".read": true,
        ".indexOn": [
          "timestamp"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['name', 'city', 'lat', 'lng', 'cards', 'timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 35"
          },
          "city": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "cards": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "lng": {
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "market": {
        ".read": true,
        ".write": false
      },
      "$other": {
        ".read": false,
        ".write": false
      }
    }
  }
}
