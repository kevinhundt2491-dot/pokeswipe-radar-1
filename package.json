{
  "name": "pokeswipe-radar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:worker && npm run build:ocr",
    "db:generate": "drizzle-kit generate",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p .",
    "build:css": "tailwindcss -i client/tailwind.css -o public/assets/tailwind.css --minify",
    "build:js": "esbuild client/main.js --bundle --splitting --minify --format=esm --target=es2020 --outdir=public/assets --entry-names=app --chunk-names=chunks/[name]-[hash]",
    "build:worker": "esbuild client/scanner/scan-worker.js --bundle --minify --format=iife --target=es2020 --outfile=public/assets/scan-worker.js",
    "cap:add": "npx cap add ios && npx cap add android && node scripts/cap-native-setup.mjs && npx cap sync",
    "cap:sync": "npx cap sync && node scripts/cap-native-setup.mjs",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test",
    "build:ocr": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.4.0",
    "@netlify/blobs": "^11.1.9",
    "@netlify/database": "^2.0.3",
    "@netlify/functions": "^6.1.1",
    "@netlify/identity": "^2.0.1",
    "@netlify/server": "^0.1.6",
    "@tesseract.js-data/eng": "^1.0.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "gotrue-js": "^1.0.1",
    "hono": "^4.13.18",
    "jpeg-js": "^0.4.4",
    "mp4-muxer": "^5.2.2",
    "stripe": "^23.1.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@playwright/test": "^1.65.1",
    "@revenuecat/purchases-capacitor": "^14.1.0",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^1.0.0-beta.22",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
